{
  "name": "freshmarkets",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "oxlint apps packages",
    "naming:check": "node scripts/verify-naming.mjs",
    "migration:check": "node scripts/verify-migrations.mjs",
    "catalog:generate": "node apps/core/scripts/generate-produce-catalog.ts",
    "catalog:check": "node apps/core/scripts/generate-produce-catalog.ts --check",
    "commit:check": "node scripts/verify-commit-message.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "format": "oxfmt --write package.json pnpm-workspace.yaml apps packages scripts",
    "format:check": "oxfmt --check package.json pnpm-workspace.yaml apps packages scripts",
    "check": "pnpm format:check && pnpm naming:check && pnpm migration:check && pnpm commit:check && pnpm lint && pnpm typecheck && pnpm test && pnpm -r build",
    "dev:web": "pnpm --filter @freshmarkets/web dev",
    "dev:core": "pnpm --filter @freshmarkets/core dev",
    "dev": "pnpm --filter @freshmarkets/web dev",
    "dev:stack": "pnpm --filter @freshmarkets/web exec wrangler dev -c dist/server/wrangler.json -c ../core/wrangler.jsonc --persist-to ../core/.wrangler/state"
  },
  "devDependencies": {
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.0.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
