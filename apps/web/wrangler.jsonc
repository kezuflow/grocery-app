{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freshmarkets-web",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "images": { "binding": "IMAGES" },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "CORE",
      "service": "freshmarkets-core",
      "entrypoint": "CoreEntrypoint",
    },
  ],
  "vars": {
    // Development-only loopback public origin. Production sets
    // PUBLIC_APP_ORIGIN through environment configuration, never a source default.
    "PUBLIC_APP_ORIGIN": "http://localhost:3000",
    "ENVIRONMENT": "development",
  },
  "secrets": {
    // PAYMONGO_PUBLIC_KEY is browser-safe, but declaring it here keeps the
    // environment-specific pk_test_/pk_live_ selection out of source control.
    // Local development reads these names from apps/web/.dev.vars.
    "required": ["GOOGLE_MAPS_BROWSER_KEY", "GOOGLE_MAPS_MAP_ID", "PAYMONGO_PUBLIC_KEY"],
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05,
    },
  },
  "env": {
    "staging": {
      "images": { "binding": "IMAGES" },
      "workers_dev": true,
      "services": [
        {
          "binding": "CORE",
          "service": "freshmarkets-core-staging",
          "entrypoint": "CoreEntrypoint",
        },
      ],
      "vars": {
        "PUBLIC_APP_ORIGIN": "https://freshmarkets.ph",
        "ENVIRONMENT": "staging",
      },
      "secrets": {
        // `CLOUDFLARE_ENV=staging` loads these names from .dev.vars.staging
        // (or .dev.vars when no environment-specific file exists). Deployments
        // require the same names on the freshmarkets-web-staging Worker.
        "required": ["GOOGLE_MAPS_BROWSER_KEY", "GOOGLE_MAPS_MAP_ID", "PAYMONGO_PUBLIC_KEY"],
      },
    },
    "production": {
      "images": { "binding": "IMAGES" },
      "workers_dev": true,
      // Cart and other business RPCs execute with this fetch handler. The D1
      // primary serves from Singapore, so keep those calls near the database.
      "placement": { "region": "aws:ap-southeast-1" },
      "routes": [
        {
          "pattern": "freshmarkets.ph",
          "custom_domain": true,
        },
      ],
      "services": [
        {
          "binding": "CORE",
          "service": "freshmarkets-core-production",
          "entrypoint": "CoreEntrypoint",
        },
      ],
      "vars": {
        "PUBLIC_APP_ORIGIN": "https://freshmarkets.ph",
        "ENVIRONMENT": "production",
      },
      "secrets": {
        // The PayMongo public key reaches the browser, but keeping its live
        // value out of Git makes environment selection explicit at deploy.
        "required": ["GOOGLE_MAPS_BROWSER_KEY", "GOOGLE_MAPS_MAP_ID", "PAYMONGO_PUBLIC_KEY"],
      },
    },
  },
}
