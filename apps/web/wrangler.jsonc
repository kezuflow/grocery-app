{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freshmarkets-web",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "CORE",
      "service": "freshmarkets-core",
      "entrypoint": "CoreEntrypoint",
    },
  ],
  "vars": {
    // Development-only loopback public origin. Production sets
    // PUBLIC_APP_ORIGIN through environment configuration, never a source default.
    "PUBLIC_APP_ORIGIN": "http://localhost:5173",
    // Local-only compatibility sandbox checkout. Production configures a real
    // payment provider and never a sandbox default.
    "ENVIRONMENT": "development",
    "PAYMENT_MODE": "sandbox",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
