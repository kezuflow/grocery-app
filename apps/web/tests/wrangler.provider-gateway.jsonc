{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "freshmarkets-e2e-provider-gateway",
  "main": "provider-gateway.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "services": [
    { "binding": "WEB", "service": "freshmarkets-web" },
    { "binding": "PAYMENT_WEBHOOK", "service": "freshmarkets-core" },
  ],
}
