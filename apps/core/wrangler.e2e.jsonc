{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "freshmarkets-core",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "ENVIRONMENT": "test",
    "BETTER_AUTH_URL": "http://localhost:3100",
    "TRUSTED_ORIGINS": "http://localhost:3100",
    "PAYMENT_PROVIDER": "mock",
    "ROUTE_DISTANCE_PROVIDER": "mapbox",
  },
  "r2_buckets": [
    {
      "binding": "PRODUCT_MEDIA",
      "bucket_name": "freshmarkets-product-media-e2e",
      "preview_bucket_name": "freshmarkets-product-media-e2e",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "freshmarkets-core-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
