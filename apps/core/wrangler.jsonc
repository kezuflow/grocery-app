{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "freshmarkets-core",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  // Every-minute tick drives time-critical fairness jobs; the quarter-hour
  // sweep bounds provider-facing redrive/reconciliation call rates. Keys must
  // match apps/core/src/scheduling/job-registry.ts exactly.
  "triggers": {
    "crons": ["* * * * *", "*/15 * * * *"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "ENVIRONMENT": "development",
    // Browser auth is always exposed through Web, including when Core runs
    // separately on Wrangler's default http://127.0.0.1:8787 listener.
    "BETTER_AUTH_URL": "http://localhost:3000",
    // Development-only loopback public origins plus the workerd test host.
    // Production sets TRUSTED_ORIGINS through environment configuration,
    // never a source default.
    "TRUSTED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000,https://core.example.invalid",
    // Deterministic mock payments are local-only. Production must not inherit
    // this variable and fails closed until an approved provider exists.
    "PAYMENT_PROVIDER": "mock",
    "ROUTE_DISTANCE_PROVIDER": "mapbox",
  },
  "secrets": {
    "required": ["MAPBOX_ACCESS_TOKEN"],
  },
  // Cloudflare Email Service supplies transactional auth delivery without an
  // API token. AUTH_EMAIL_FROM is deployment configuration and intentionally
  // has no source-controlled production default.
  "send_email": [{ "name": "EMAIL" }],
  "r2_buckets": [
    {
      "binding": "PRODUCT_MEDIA",
      "bucket_name": "freshmarkets-product-media-dev",
      "preview_bucket_name": "freshmarkets-product-media-dev",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "freshmarkets-core-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
