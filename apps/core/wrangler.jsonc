{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "freshmarkets-core",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  // Every-minute tick drives time-critical fairness jobs; the quarter-hour
  // sweep bounds provider-facing redrive/reconciliation call rates. Keys must
  // match apps/core/src/scheduling/job-registry.ts exactly.
  "triggers": {
    "crons": ["* * * * *", "*/15 * * * *"],
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05,
    },
  },
  "vars": {
    "ENVIRONMENT": "development",
    // One-use setup is disabled until an explicitly chosen email is configured.
    "INITIAL_GLOBAL_ADMIN_EMAIL": "",
    // Browser auth is always exposed through Web, including when Core runs
    // separately on Wrangler's default http://127.0.0.1:8787 listener.
    "BETTER_AUTH_URL": "http://localhost:3000",
    // Development-only loopback public origins plus the workerd test host.
    // Production sets TRUSTED_ORIGINS through environment configuration,
    // never a source default.
    "TRUSTED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000,https://core.example.invalid",
    // Local runtime fails closed until PayMongo sandbox credentials are bound.
    "PAYMENT_PROVIDER": "disabled",
    // The customer-visible Instant catalog is explicit and ordered. Every
    // environment stays disabled until credentials and GET /v3/cities service
    // evidence have been supplied outside source control.
    "DELIVERY_PROVIDER": "disabled",
    "DELIVERY_PROVIDERS": "disabled",
    "ROUTE_DISTANCE_PROVIDER": "mapbox",
  },
  "secrets": {
    "required": ["MAPBOX_ACCESS_TOKEN", "PAYMONGO_SECRET_KEY", "PAYMONGO_WEBHOOK_SECRET"],
  },
  // Cloudflare Email Service supplies transactional auth delivery without an
  // API token. AUTH_EMAIL_FROM is deployment configuration and intentionally
  // has no source-controlled production default.
  "send_email": [{ "name": "EMAIL" }],
  "queues": {
    "producers": [{ "binding": "NOTIFICATION_QUEUE", "queue": "freshmarkets-notifications-dev" }],
    "consumers": [
      {
        "queue": "freshmarkets-notifications-dev",
        "dead_letter_queue": "freshmarkets-notifications-dlq-dev",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 60,
      },
    ],
  },
  "r2_buckets": [
    {
      "binding": "PRODUCT_MEDIA",
      "bucket_name": "freshmarkets-product-media-dev",
      "preview_bucket_name": "freshmarkets-product-media-dev",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "freshmarkets-core-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    "staging": {
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "staging",
        "INITIAL_GLOBAL_ADMIN_EMAIL": "",
        "BETTER_AUTH_URL": "https://freshmarkets.ph",
        "TRUSTED_ORIGINS": "https://freshmarkets.ph,https://freshmarkets-web-staging.ilyreggie.workers.dev",
        "PAYMENT_PROVIDER": "paymongo",
        "DELIVERY_PROVIDER": "disabled",
        "DELIVERY_PROVIDERS": "disabled",
        "ROUTE_DISTANCE_PROVIDER": "mapbox",
      },
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRET",
          "GOOGLE_CLIENT_ID",
          "GOOGLE_CLIENT_SECRET",
          "MAPBOX_ACCESS_TOKEN",
          "PAYMONGO_SECRET_KEY",
          "PAYMONGO_WEBHOOK_SECRET",
        ],
      },
      "send_email": [{ "name": "EMAIL" }],
      "queues": {
        "producers": [
          { "binding": "NOTIFICATION_QUEUE", "queue": "freshmarkets-notifications-staging" },
        ],
        "consumers": [
          {
            "queue": "freshmarkets-notifications-staging",
            "dead_letter_queue": "freshmarkets-notifications-dlq-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "retry_delay": 60,
          },
        ],
      },
      "r2_buckets": [
        {
          "binding": "PRODUCT_MEDIA",
          "bucket_name": "freshmarkets-product-media-staging",
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "freshmarkets-core-staging",
          "database_id": "48aaa957-2be1-4883-9998-5321a49d2825",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
