{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "freshmarkets-core",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "ENVIRONMENT": "development",
    "BETTER_AUTH_URL": "http://127.0.0.1:8788",
    // Development-only loopback origins plus the workerd test host. Production sets
    // TRUSTED_ORIGINS through environment configuration, never a source default.
    "TRUSTED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,https://core.example.invalid",
    // Compatibility sandbox payments are local-only. Production has no default
    // and must configure a real payment provider instead.
    "PAYMENT_MODE": "sandbox",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "freshmarkets-core-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
