#!/bin/sh
zero=0000000000000000000000000000000000000000
cd "$(git rev-parse --show-toplevel)" || exit 1
node scripts/verify-naming.mjs || exit 1

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/codex/*) ;;
    *)
      echo "pre-push: rejected $remote_ref; use a codex/ PR branch." >&2
      exit 1
      ;;
  esac
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base "$local_sha" refs/remotes/origin/main) || {
      echo "pre-push: fetch origin/main before an initial branch push." >&2
      exit 1
    }
  else
    base=$remote_sha
  fi
  node scripts/verify-commit-message.mjs --range "$base..$local_sha" || exit 1
done
